[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
DriverVer=10/27/2026,0.1.0.0
CatalogFile=degastouch.cat
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTarm64.10.0...26100
[Models.NTarm64.10.0...26100]
%Device%=Install,ACPI\DGS0002
[DestinationDirs]
DriverCopy=13
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
degastouch.sys=1
[Install.NT]
CopyFiles=DriverCopy
[DriverCopy]
degastouch.sys
[Install.NT.HW]
AddReg=HardwareSettings
[HardwareSettings]
HKR,,LowerFilters,0x00010000,"vhf"
[Install.NT.Services]
AddService=DegasTouch,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\degastouch.sys
[Install.NT.Wdf]
